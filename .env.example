# LLM 接入（百炼 OpenAI 兼容模式；密钥勿提交）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_MODEL=gte-rerank-v2
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 数据库（本机 Docker PG；compose 栈用 5433 避免与本机既有实例冲突）
DATABASE_URL=postgresql+asyncpg://root:123456@localhost:5432/atlas
TEST_DATABASE_URL=postgresql+asyncpg://root:123456@localhost:5432/atlas_test

# JWT（章程 V / ADR-009）
JWT_SECRET=dev-secret-change-me
JWT_EXP_HOURS=24

# 检索 / 收敛
EMBEDDING_DIM=1024
HYBRID_TOP_K=50
RERANK_TOP_K=5
# 检索是否经过重排模型（rerank 配额受限时可置 false：按 RRF 分排序，拒答仅剩零命中判定）
USE_RERANK=true
# 拒答阈值：初值 0.35，验收前用 L4 子集校准（tasks T041）
REFUSAL_THRESHOLD=0.35
CHAIN_TIMEOUT_S=20
